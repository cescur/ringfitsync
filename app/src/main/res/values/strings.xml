    <!-- Privacy -->
    <string name="privacy_heading">How FitLog uses your data</string>
    <string name="privacy_text">Text in your photos is recognized on the phone itself, and workouts are only stored in this app and in Health Connect. The app doesn’t use the internet, has no ads or analytics, and only shares data when you export the CSV.</string>
    <string name="privacy_text_health">FitLog only writes exercise sessions, active calories and distance to Health Connect for the days you confirm, and reads those same types so it can replace or delete what it saved.</string>
